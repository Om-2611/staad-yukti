# Example Vite env file for Firebase configuration
# Copy this to .env.local or .env and fill in the values.
# Keys must be prefixed with VITE_ to be exposed to the client by Vite.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optionally you can add environment-specific variables like:
# VITE_APP_NAME=STAAD
